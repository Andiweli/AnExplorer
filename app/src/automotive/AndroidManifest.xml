<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:name=".AutomotiveSafeApplication"
        tools:replace="android:name">

        <!--
             AAOS SAFE MODE

             The automotive build deliberately removes every legacy AnExplorer component that
             can be created before or alongside the launcher activity. Android instantiates
             ContentProviders before Application.onCreate(), so leaving the old provider/root
             stack enabled would re-introduce the original Renault startup crash path.

             SafeMode4 is Play-compliant and targets API 35. On Renault AAOS 12/API 32 the
             bootstrap activity first requests the normal READ_EXTERNAL_STORAGE runtime
             permission, then launches the isolated safe-mode browser. Scoped Storage still
             remains in force unless the OEM exposes and grants MANAGE_EXTERNAL_STORAGE.

             Mobile remains untouched; these removals exist only in src/automotive.
        -->

        <activity android:name=".DocumentsActivity" tools:node="remove" />
        <activity android:name=".StandaloneActivity" tools:node="remove" />
        <activity android:name=".setting.SettingsActivity" tools:node="remove" />
        <activity android:name=".AboutActivity" tools:node="remove" />
        <activity android:name=".NoteActivity" tools:node="remove" />
        <activity android:name=".common.WebviewActivity" tools:node="remove" />

        <receiver android:name=".receiver.PackageReceiver" tools:node="remove" />
        <receiver android:name=".receiver.MountReceiver" tools:node="remove" />
        <receiver android:name=".receiver.ConnectionsReceiver" tools:node="remove" />

        <service android:name=".service.ConnectionsService" tools:node="remove" />
        <service android:name=".service.ServerService" tools:node="remove" />

        <provider
            android:name="dev.dworks.apps.anexplorer.provider.ContentProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.RecentsProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.ExternalStorageProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.MediaDocumentsProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.NonMediaDocumentsProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.AppsProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.RootedStorageProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.HeatMapProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.DownloadStorageProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.ExplorerProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.UsbStorageProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.NetworkStorageProvider"
            tools:node="remove" />
        <provider
            android:name="dev.dworks.apps.anexplorer.provider.CloudStorageProvider"
            tools:node="remove" />

        <activity
            android:name=".AutomotiveSafeModeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <meta-data
                android:name="WindowManagerPreference:SuppressWindowControlNavigationButton"
                android:value="true" />
        </activity>

        <activity
            android:name=".AutomotivePermissionBootstrapActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="WindowManagerPreference:SuppressWindowControlNavigationButton"
                android:value="true" />
        </activity>
    </application>
</manifest>
